# ──────────────────────────────────────────────
# Tripers — Server Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# On Render, set these in Dashboard → Environment tab.
#
# IMPORTANT: mongodb+srv:// URIs must NOT have a port number.
# Use the exact string from MongoDB Atlas → Connect → Drivers.

NODE_ENV=production
PORT=10000

# MongoDB Atlas (required)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>
# DO NOT append :27017 or any port — SRV URIs resolve ports automatically.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripers?retryWrites=true&w=majority&appName=TripersDB

# JWT Secrets — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_ACCESS_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Cloudinary (for photo/receipt/cover uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email / SMTP (for registration + password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=Tripers <noreply@tripers.app>

# Client URL (for CORS + email links — set to your Vercel URL in production)
CLIENT_URL=https://your-frontend.vercel.app
