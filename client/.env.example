# ──────────────────────────────────────────────
# Tripers — Client Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local (for dev) or set in Render Dashboard (for production).

# Backend API URL
# Leave empty for local dev (uses Vite proxy / relative paths).
# Set to your Render backend URL for production builds.
VITE_API_URL=

# Example for Render production:
# VITE_API_URL=https://your-backend.onrender.com
